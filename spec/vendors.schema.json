{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/josh-hemphill/instrument-components/spec/vendors.schema.json",
  "title": "Vendor dialect profile",
  "description": "Hardware vendor SCPI dialect loaded by tools/gen-dialects.ts and merged before generic_* profiles.",
  "type": "object",
  "required": ["id", "kind", "manufacturerGlob", "modelGlob", "commands"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "kind": {
      "enum": [
        "Dmm",
        "DcPowerSupply",
        "FunctionGenerator",
        "Oscilloscope",
        "Switch",
        "Counter",
        "PowerMeter",
        "SpectrumAnalyzer"
      ]
    },
    "manufacturerGlob": { "type": "string", "minLength": 1 },
    "modelGlob": { "type": "string", "minLength": 1 },
    "channels": { "type": "integer", "minimum": 1 },
    "commands": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  }
}
